    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": 
     [
      {
        "Provider": "PostgreSql",
        "Host": "34.218.235.181",
        "Port": "5432",
        "Database": "bd_invitado",
        "UserId": "app_api_pg01_clienteunico",
        "Password": "63IP#Sl9FqZ7z6Az"
